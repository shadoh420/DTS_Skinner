# Store text files with LF line endings whatever the committing tool wrote (app.py came in with CRLF once).
* text=auto
# Keep the imported image catalog out of ordinary Git object history.
/static/textures/t2/*.png filter=lfs diff=lfs merge=lfs -text
# Preserve generated upstream shader/script literals and license notices verbatim.
/static/t2-maps/** -text -whitespace linguist-generated=true
